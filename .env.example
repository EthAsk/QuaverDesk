APP_NAME="QuaverDesk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Comma-separated proxy IPs/CIDRs in front of the app (needed so client IPs
# and https URLs are seen correctly). Leave empty
# if the app is reached directly.
TRUSTED_PROXIES=

# Let the first visitor create the owner account in the browser. In production
# set this to false and run `php artisan user:create-owner` instead.
ALLOW_WEB_SETUP=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=quaverdesk
# DB_USERNAME=quaverdesk
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Microsoft 365 (MAIL_MAILER=graph): see docs/DEPLOYMENT.md, Email.
MAIL_GRAPH_TENANT_ID=
MAIL_GRAPH_CLIENT_ID=
MAIL_GRAPH_CLIENT_SECRET=

# --- Voice server (FreeSWITCH) — see docs/VOICE-SERVER.md -----------------
# SIP domain phones sign in to, e.g. voice.example.co.uk (must resolve to the
# voice server).
VOICE_DOMAIN=
# Shared secret FreeSWITCH sends with every webhook: 32+ letters and digits
# (e.g. `openssl rand -hex 24`).
VOICE_WEBHOOK_SECRET=
# Where FreeSWITCH reaches this app (defaults to APP_URL).
VOICE_APP_URL=
# Folder the app writes FreeSWITCH settings into (users, trunks, allow-list).
VOICE_CONF_DIR=/etc/freeswitch/quaverdesk
# Softphones connect here: wss://VOICE_DOMAIN:7443
VOICE_WEBSOCKET_URL=
# Public IP of the voice server (empty = detect automatically).
VOICE_EXTERNAL_IP=
# Desk phones over TLS (5061) and browsers over wss:// (7443). Keep true in production.
VOICE_TLS=true
# Address your SIP trunk provider sends calls to, shown on the trunk page.
VOICE_TRUNK_ADDRESS=
# FreeSWITCH event socket, used to reload settings (localhost only).
VOICE_ESL_HOST=127.0.0.1
VOICE_ESL_PORT=8021
VOICE_ESL_PASSWORD=
# Number shown on outgoing calls unless set under Admin → Calling rules.
VOICE_CALLER_ID=

# Spoken prompts (greetings, menus, messages). "piper" is a natural-sounding
# voice that runs on this server (see docs/VOICE-SERVER.md#speech);
# "freeswitch" is FreeSWITCH's built-in robotic voice; "command" runs any other
# text-to-speech program (JSON array; text on stdin, {out} = WAV file to write).
TTS_DRIVER=piper
TTS_PIPER_BINARY=/opt/piper/bin/piper
TTS_PIPER_VOICE=/opt/piper/voices/en_GB-cori-high.onnx
# Folder of Piper voices admins can pick from under Admin → Voice (default: TTS_PIPER_VOICE's folder).
TTS_PIPER_VOICES=
# Kokoro, the most natural voices (optional; see docs/VOICE-SERVER.md#speech).
TTS_KOKORO_PYTHON=/opt/kokoro/venv/bin/python
TTS_KOKORO_MODELS=
TTS_KOKORO_VOICE=bf_emma
# Speaking pace, 0.7 to 1.3. Admins can change it under Admin → Voice.
TTS_SPEED=1.0
TTS_COMMAND=

# Converts uploaded greetings and hold music (apt install ffmpeg).
FFMPEG_BINARY=ffmpeg

VITE_APP_NAME="${APP_NAME}"

# --- Licence renewal -------------------------------------------------------
# Paid licences renew each billing period. Your install fetches its renewed key
# from here once a day, sending only its current key. Leave empty to paste
# renewed keys in by hand.
LICENCE_SERVER_URL=https://quaverdesk.app

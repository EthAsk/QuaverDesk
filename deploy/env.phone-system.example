# QuaverDesk — production .env for a customer phone system.
# Copy to /srv/quaverdesk/.env, fill in every blank, then: chmod 600 .env
# After any change: sudo -u quaverdesk php artisan optimize

APP_NAME="QuaverDesk"
APP_ENV=production
# php artisan key:generate — then store a copy in your password manager
APP_KEY=
APP_DEBUG=false
APP_URL=https://phone.example.co.uk
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Set only if a load balancer / Cloudflare sits in front (see DEPLOYMENT.md).
TRUSTED_PROXIES=

# Create the owner with `php artisan user:create-owner` instead of the web page.
ALLOW_WEB_SETUP=false

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quaverdesk
DB_USERNAME=quaverdesk
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# A transactional email provider (SMTP). Set up SPF, DKIM and DMARC for the domain.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="voicemail@phone.example.co.uk"
MAIL_FROM_NAME="${APP_NAME}"

# Where your install fetches renewed licence keys once a day (sends only the
# current key). Leave empty to paste renewed keys in by hand.
LICENCE_SERVER_URL=https://quaverdesk.app

# --- Voice server (FreeSWITCH) — see docs/VOICE-SERVER.md -----------------
# SIP domain phones sign in to, e.g. voice.example.co.uk (must resolve to the
# voice server).
VOICE_DOMAIN=
# Shared secret FreeSWITCH sends with every webhook: 32+ letters and digits
# (e.g. `openssl rand -hex 24`).
VOICE_WEBHOOK_SECRET=
# Where FreeSWITCH reaches this app (defaults to APP_URL).
VOICE_APP_URL=
# Folder the app writes FreeSWITCH settings into (users, trunks, allow-list).
VOICE_CONF_DIR=/etc/freeswitch/quaverdesk
# Softphones connect here: wss://VOICE_DOMAIN:7443
VOICE_WEBSOCKET_URL=
# Public IP of the voice server (empty = detect automatically).
VOICE_EXTERNAL_IP=
# Desk phones over TLS (5061) and browsers over wss:// (7443). Keep true in production.
VOICE_TLS=true
# Address your SIP trunk provider sends calls to, shown on the trunk page.
VOICE_TRUNK_ADDRESS=
# FreeSWITCH event socket, used to reload settings (localhost only).
VOICE_ESL_HOST=127.0.0.1
VOICE_ESL_PORT=8021
VOICE_ESL_PASSWORD=
# Number shown on outgoing calls unless set under Admin → Calling rules.
VOICE_CALLER_ID=

# Spoken prompts (greetings, menus, messages). "kokoro" and "piper" are natural-
# sounding voices that run on this server (see docs/VOICE-SERVER.md#speech);
# "freeswitch" is FreeSWITCH's built-in robotic voice; "command" runs any other
# text-to-speech program (JSON array; text on stdin, {out} = WAV file to write).
TTS_DRIVER=piper
TTS_PIPER_BINARY=/opt/piper/bin/piper
TTS_PIPER_VOICE=/opt/piper/voices/en_GB-cori-high.onnx
# Folder of Piper voices admins can pick from under Admin → Voice (default: TTS_PIPER_VOICE's folder).
TTS_PIPER_VOICES=
# Kokoro, the most natural voices (optional; see docs/VOICE-SERVER.md#speech).
TTS_KOKORO_PYTHON=/opt/kokoro/venv/bin/python
TTS_KOKORO_MODELS=
TTS_KOKORO_VOICE=bf_emma
# Speaking pace, 0.7 to 1.3. Admins can change it under Admin → Voice.
TTS_SPEED=1.0
TTS_COMMAND=

# Converts uploaded greetings and hold music (apt install ffmpeg).
FFMPEG_BINARY=ffmpeg


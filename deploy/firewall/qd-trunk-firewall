#!/bin/bash
# QuaverDesk: only SIP trunk providers may reach the trunk ports (5080 UDP/TCP, 5081 TLS).
#
# The allowed addresses are the ones QuaverDesk writes from Admin -> SIP trunks into
# FreeSWITCH's trunk ACL. qd-trunk-firewall.path re-runs this whenever that file changes,
# so adding a provider in the app opens the firewall for it within a second or so.
#
# Fails safe: if the file is missing, unreadable or lists nothing valid, the last good list
# is kept (or, at first run, the trunk ports are left alone). FreeSWITCH's own ACL still
# refuses anyone not on the list either way.
#
# Install (as root): see "Firewall" in docs/VOICE-SERVER.md.
#   qd-trunk-firewall            apply the rules
#   qd-trunk-firewall --dry-run  print the rules it would apply, change nothing
set -euo pipefail
DRY_RUN=0
[ "${1:-}" = "--dry-run" ] && DRY_RUN=1

ACL="${QD_TRUNK_ACL:-/etc/freeswitch/quaverdesk/acl/trunks.xml}"
STATE_DIR="${QD_TRUNK_FIREWALL_STATE:-/var/lib/qd-trunk-firewall}"
LAST_GOOD=$STATE_DIR/allowed.txt
PORTS="5080, 5081"
TABLE=qd_trunks

log() { [ "$DRY_RUN" = 1 ] || logger -t qd-trunk-firewall -- "$*"; echo "$*" >&2; }
[ "$DRY_RUN" = 1 ] || mkdir -p "$STATE_DIR"

parse() {
    python3 -I - "$ACL" <<'PY'
import ipaddress, re, sys
try:
    text = open(sys.argv[1], encoding="utf-8").read()
except OSError:
    sys.exit(0)
seen = []
for c in re.findall(r'<node\s+type="allow"\s+cidr="([^"]+)"', text):
    try:
        net = ipaddress.ip_network(c, strict=False)
    except ValueError:
        continue
    if net.version == 4 and net.prefixlen >= 8 and not net.is_private and not net.is_loopback:
        if str(net) not in seen:
            seen.append(str(net))
print("\n".join(seen))
PY
}

allowed="$(parse || true)"
if [ -z "$allowed" ]; then
    if [ -s "$LAST_GOOD" ]; then
        allowed="$(cat "$LAST_GOOD")"
        log "No usable trunk addresses in $ACL; keeping the last good list ($(wc -l < "$LAST_GOOD") entries)."
    elif [ "$DRY_RUN" = 0 ] && nft list table inet "$TABLE" >/dev/null 2>&1; then
        log "No usable trunk addresses in $ACL; leaving the current firewall table alone."
        exit 0
    else
        log "No usable trunk addresses in $ACL and no earlier list; trunk ports left open (FreeSWITCH ACL still applies)."
        exit 0
    fi
fi

elements="$(echo "$allowed" | paste -sd, - | sed 's/,/, /g')"
rules="$(mktemp)"
trap 'rm -f "$rules"' EXIT
cat > "$rules" <<NFT
table inet $TABLE
delete table inet $TABLE
table inet $TABLE {
    set trunk_providers {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { $elements }
    }
    chain input {
        type filter hook input priority filter - 5; policy accept;
        iif "lo" accept
        meta l4proto { tcp, udp } th dport { $PORTS } ct state established,related accept
        meta l4proto { tcp, udp } th dport { $PORTS } ip saddr @trunk_providers accept
        meta l4proto { tcp, udp } th dport { $PORTS } counter drop comment "not a SIP trunk provider"
    }
}
NFT

if [ "$DRY_RUN" = 1 ]; then cat "$rules"; exit 0; fi

# Check first, then swap the whole table in one transaction (no moment with no rules).
nft -c -f "$rules"
nft -f "$rules"
echo "$allowed" > "$LAST_GOOD.tmp" && mv "$LAST_GOOD.tmp" "$LAST_GOOD"
log "Trunk ports ($PORTS) now allow $(echo "$allowed" | wc -l) provider range(s) only."

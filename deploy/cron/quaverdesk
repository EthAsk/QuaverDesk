# QuaverDesk scheduler (recording retention clean-up, daily licence renewal)
# and nightly backup.
# Install: sudo cp deploy/cron/quaverdesk /etc/cron.d/quaverdesk && sudo chmod 644 /etc/cron.d/quaverdesk
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

* * * * *  quaverdesk  cd /srv/quaverdesk && php artisan schedule:run >> /dev/null 2>&1
# Root-owned copy (see DEPLOYMENT.md): never run a root job from the app folder.
30 2 * * * root        /usr/local/sbin/quaverdesk-backup >> /var/log/quaverdesk-backup.log 2>&1

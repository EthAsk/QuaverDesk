<configuration name="logfile.conf" description="Log file">
  <settings><param name="rotate-on-hup" value="true"/></settings>
  <profiles>
    <profile name="default">
      <settings><param name="rollover" value="10485760"/><param name="maximum-rotate" value="10"/></settings>
      <mappings><map name="all" value="info,notice,warning,err,crit,alert"/></mappings>
    </profile>
  </profiles>
</configuration>

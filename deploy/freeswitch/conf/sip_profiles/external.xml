<!--
  SIP trunks to and from the phone network. Calls are accepted only from the
  providers' addresses (ACL "trunks") and go straight to the "public" context,
  which can only reach our own numbers.
-->
<profile name="external">
  <gateways>
    <X-PRE-PROCESS cmd="include" data="../quaverdesk/gateways/*.xml"/>
  </gateways>
  <settings>
    <param name="context" value="public"/>
    <param name="sip-ip" value="$${local_ip_v4}"/>
    <param name="rtp-ip" value="$${local_ip_v4}"/>
    <param name="ext-sip-ip" value="$${qd_external_ip}"/>
    <param name="ext-rtp-ip" value="$${qd_external_ip}"/>
    <param name="sip-port" value="$${external_sip_port}"/>
    <param name="apply-inbound-acl" value="trunks"/>
    <param name="auth-calls" value="true"/>
    <param name="accept-blind-reg" value="false"/>
    <param name="accept-blind-auth" value="false"/>
    <param name="disable-register" value="true"/>
    <param name="inbound-codec-prefs" value="$${codecs_external}"/>
    <param name="outbound-codec-prefs" value="$${codecs_external}"/>
    <param name="inbound-codec-negotiation" value="generous"/>
    <param name="dtmf-type" value="rfc2833"/>
    <param name="rtp-timeout-sec" value="300"/>
    <param name="rtp-hold-timeout-sec" value="1800"/>
    <param name="manage-presence" value="false"/>
    <param name="user-agent-string" value="QuaverDesk"/>
  </settings>
</profile>

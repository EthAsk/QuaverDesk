<include>
  <domain name="$${domain}">
    <params>
      <!-- A call ringing one of our phones is shown on busy lamps under the person's
           secret BLF address (the user's presence_id variable), never their SIP username. -->
      <param name="dial-string" value="{^^:sip_invite_domain=${dialed_domain}:presence_id=${user_data(${dialed_user}@${dialed_domain} var presence_id)}}${sofia_contact(*/${dialed_user}@${dialed_domain})}"/>
      <param name="jsonrpc-allowed-methods" value=""/>
    </params>
    <groups>
      <group name="default">
        <users>
          <!-- Written by the app: one user per softphone and desk phone. -->
          <X-PRE-PROCESS cmd="include" data="../quaverdesk/directory/*.xml"/>
        </users>
      </group>
    </groups>
  </domain>
</include>

<include>
  <domain name="$${domain}">
    <params>
      <param name="dial-string" value="{^^:sip_invite_domain=${dialed_domain}:presence_id=${dialed_user}@${dialed_domain}}${sofia_contact(*/${dialed_user}@${dialed_domain})}"/>
      <param name="jsonrpc-allowed-methods" value=""/>
    </params>
    <groups>
      <group name="default">
        <users>
          <!-- Written by the app: one user per softphone and desk phone. -->
          <X-PRE-PROCESS cmd="include" data="../quaverdesk/directory/*.xml"/>
        </users>
      </group>
    </groups>
  </domain>
</include>
